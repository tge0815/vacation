# Lokale Dev-Vorlage. Kopiere zu .env.local fuer `npm run dev`.
#
# WICHTIG: KEIN ANTHROPIC_API_KEY. Die KI laeuft ausschliesslich ueber
# Claude Code mit Max-Plan-Subscription. Auth via `claude login` auf dem
# Host, dann ./setup.sh (kopiert die Credentials ins Docker-Volume).

LEARN_AGENT_DEFAULT_MODEL=claude-sonnet-4-6
LEARN_AGENT_REASONING_MODEL=claude-opus-4-8
LEARN_DATA_DIR=./data
