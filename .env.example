# Lokale Dev-Vorlage. Kopiere zu .env (docker compose) bzw. .env.local (npm run dev).

# === KI: Anthropic-API-Key (Pflicht) ===
# Key aus der Anthropic Console: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Standard = schnelles/günstiges Haiku, Reasoning = Sonnet (Textaufgaben & Eltern-Coach)
LEARN_AGENT_DEFAULT_MODEL=claude-haiku-4-5-20251001
LEARN_AGENT_REASONING_MODEL=claude-sonnet-4-6
LEARN_DATA_DIR=./data

# === Login / Mehr-Familien ===
# Einladungscode für die Registrierung neuer Familien (unbedingt ändern!).
LEARN_INVITE_CODE=bitte-aendern
# Secret zum Signieren der Login-Sessions (langer Zufallswert; setup.sh erzeugt einen).
LEARN_SESSION_SECRET=bitte-einen-langen-zufallswert-setzen
# Standard-Familie für bereits vorhandene lokale Kinder (Login nach dem Update).
LEARN_DEFAULT_FAMILY_EMAIL=eltern@local
LEARN_DEFAULT_FAMILY_PASSWORD=lernen
# Auf 1 setzen, wenn hinter HTTPS (härtere Login-Cookies).
LEARN_COOKIE_SECURE=0
